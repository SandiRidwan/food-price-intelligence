# Template kredensial — SALIN ke .env lalu isi (untuk LOCAL).
# Daftar API key gratis di: https://webapi.bps.go.id/developer/login
BPS_API_KEY=your_bps_api_key_here

# ---------------------------------------------------------------------------
# Untuk DEPLOY ke Streamlit Cloud:
#   JANGAN pakai file ini. Set lewat dashboard Streamlit:
#   App → Settings → Secrets, lalu isi:
#
#   BPS_API_KEY = "kunci_anda"
#
# Alternatif tanpa kredensial: dashboard & pipeline memakai data/marts/*.parquet
# yang di-commit, sehingga app tetap berjalan tanpa key.
# ---------------------------------------------------------------------------
