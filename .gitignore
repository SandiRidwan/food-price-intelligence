__pycache__/
*.py[cod]
.venv/
venv/
.ipynb_checkpoints/

# Database (dibangun ulang oleh pipeline)
db/*.duckdb
db/*.duckdb.wal

# Staging (dibangun ulang oleh pipeline) — besar, tidak di-commit
data/staging/*
!data/staging/.gitkeep

# CATATAN: data/marts/*.parquet SENGAJA di-commit (~90KB, kecil) agar
# dashboard Streamlit Cloud berjalan TANPA kredensial/pipeline.
data/marts/*.csv

# Kredensial — JANGAN pernah commit
.env
*.key
*credentials*.json
.streamlit/secrets.toml

# Laporan sementara
reports/_*
